<section>
    {{#if data}}
    <header class="dashboard-header">
        <h1 class="logo">WELLS FARGO</h1>

        <nav class="navbar" id="menu">
            <a onclick="closeMenu()" class="menu-links" href="/dashboard">Home</a>
            <a onclick="closeMenu()" class="menu-links" href="#transfer">Transfer</a>
            <a onclick="closeMenu()" class="menu-links" href="#transaction">Transactions</a>
            <a onclick="closeMenu()" class="menu-links" href="#history">History</a>
        </nav>
        
        <div class="hamburger" id="hamburger" onclick="toggleMenu()">
                &#9776; <!-- Hamburger Icon -->
        </div>
        {{!-- <h1>Account Dashboard</h1> --}}
    </header>

    <div class="container">
        <div class="banner">
            <h3 id="current-user">Hi, {{data.userName}}</h3>
        </div>
        {{!-- error message --}}
        {{#if error}}
        <p class="error-message">{{error}}</p>
        {{/if}}
        {{!-- success message --}}
        {{#if message}}
        <p class="success-message">{{message}}</p>
        {{/if}}
        <div class="dashboard-content">
            <div class="sidebar">
                <div class="card">
                    <h4><strong>{{data.fullName}}</strong></h4>
                    <p style="font-size:1.4rem;">Available Cash</p>
                    <p class="balance">${{data.account.balance}}</p>
                </div>
                <div class="card">
                    <h3>Recent Activity</h3>
                    <ul>
                        <li>Credit: $200.00 from VX Donald</li>
                        <li>Declined: $800,000.00 To .....49523</li>  
                    </ul>
                </div>
            </div>
        
            <div class="main-content" id="history">
                <h2>Transaction History</h2>
                <table class="transaction-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th>Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each transactions}}
                        <tr>
                            <td class="date">{{createdAt}}</td>
                            <td>{{description}}</td>
                            {{#if isDebit}}
                                <td class="amount debit">${{amount}}</td>
                                {{else}}
                                <td class="amount credit">${{amount}}</td>
                            {{/if}}
                            
                            <td>{{type}}</td>
                        </tr>
                        {{/each}}
                        {{!-- <tr>
                            <td>01/08/2025</td>
                            <td>Deposit from share gains</td>
                            <td class="amount credit">$205,000.00</td>
                            <td>Credit</td>
                        </tr> --}}
                    </tbody>
                </table>
            </div>
        
            <div class="main-content" id="transfer">
                <div class="transfer-section" style="width: 100%;">
                    <h2 style="width: 100%;" style="color: red;">Transfer Money</h2>
                    <div style="width: 100%;">
                        <form style="width: 100%;" action="/transaction" method="post">
                            {{!-- <label for="">From
                                <input class="login-input transfer-input" type="text" name="from_account_no" id="">
                            </label> --}}
                            <label for="">To
                                <input class="login-input transfer-input" type="text" name="to_account_no" id=""
                                    placeholder="Account Number">
                            </label>
                            <label for="">Amount
                                <input class="login-input transfer-input" type="text" name="amount" id="" placeholder="Amount">
                            </label>
                            <button type="submit" class="login-button">Proceed</button>
                        </form>
                    </div>
                </div>
        
                <div id="transaction" style="width: 100%; padding-top:1rem;" class="scheduled-payment-section">
                    <div style="width: 100%; border:1px solid rgb(93, 90, 90); height:35px; display:flex; align-items:center; margin-bottom:1.2rem;">
                        <p style="width: 100%; text-align:center; font-size:small;">Schedued Transfers &amp; payment</p>
                    </div>
                    <div style="width: 100%;">
                        {{#each data.transactions}}
                        <div style="width: 100%;" class="transfer-details">
                            {{#if isDebit}}
                            <div style="display: flex; align-items:center; justify-content:space-between; width: 100%;">    
                                    <p><strong style="color: blue;">Send</strong> <span class="date">{{createdAt}}</span> <span style="color: green;">&#x21bb;</span>
                                </p>
                                    <p style="font-size: 1.5rem;">${{amount}}</p>
                               
                                
                            </div>
                            <div style="width: 100%;">
                                <p><strong>From</strong><span>.....22385</span> <span>--></span> <strong>To</strong>
                                    <span>{{receiverAccountNo}}</span>
                                </p>
                            </div>
                            <div style="display: flex; width:100%;">
                                <p><small>{{status}}</small></p>
                            </div>
                             {{/if}}
                        </div>
                        {{/each}}
                       
                    </div>
                </div>
            </div>
        </div>
        </div>
        
        <footer>
            {{!-- <p>&copy; 1999 - 2025 Wells Fargo. All rights reserved. NMLSR ID 399801.</p> --}}
            <p>© 1999 - 2025 Wells Fargo. All rights reserved. NMLSR ID 399801.</p>
        </footer>
        {{/if}}
</section>